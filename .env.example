# Network selection; RPC URL and passphrase are loaded from environments.toml.
STELLAR_NETWORK=testnet

# Contract addresses (after deployment)
CONTRACT_ASSET_REGISTRY=<your-contract-id>
CONTRACT_ENGINEER_REGISTRY=<your-contract-id>
CONTRACT_LIFECYCLE=<your-contract-id>

# Optional frontend network selection
VITE_STELLAR_NETWORK=testnet

# Backup to S3 (use an AWS profile/role, or uncomment static credentials)
BACKUP_S3_BUCKET=
# Set static credentials only when not using an AWS credential provider:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Local event streaming and metrics exporter
EXPORTER_PORT=9600
POLL_SECONDS=5
SCRAPE_INTERVAL=60
