# Network configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Contract addresses (after deployment)
# deploy_testnet.sh writes the deployed contract IDs to deployments/testnet.env.
# Instead of filling in these placeholders by hand, either source that file
# (e.g. `set -a; . deployments/testnet.env; set +a`) or copy its CONTRACT_*
# values here. See deployments/testnet.env for the authoritative IDs.
CONTRACT_ASSET_REGISTRY=<your-contract-id>
CONTRACT_ENGINEER_REGISTRY=<your-contract-id>
CONTRACT_LIFECYCLE=<your-contract-id>

# Frontend configuration
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org